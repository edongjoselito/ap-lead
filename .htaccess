Options -Indexes -MultiViews
ServerSignature Off

RewriteEngine On

# The application uses GET/HEAD for reads and POST for mutations.
RewriteCond %{REQUEST_METHOD} !^(GET|HEAD|POST)$ [NC]
RewriteRule ^ - [E=APLEAD_METHOD_BLOCKED:1,R=405,L]
ErrorDocument 405 "This endpoint accepts GET, HEAD, and POST requests only."

# Drop known scanner signatures early. Request limits also apply when bots
# disguise themselves as normal browsers; User-Agent checks alone are not trust.
RewriteCond %{HTTP_USER_AGENT} (?:sqlmap|nikto|masscan|zgrab|acunetix|wpscan|netsparker|nexpose|openvas) [NC]
RewriteRule ^ - [F,L]

# Never serve source-control metadata, database exports, backups, dependency
# manifests, or one-off migration scripts from the public web root.
RewriteRule ^\.well-known/acme-challenge/[A-Za-z0-9_-]+$ - [L]
RewriteRule (^|/)\. - [F,L]
RewriteRule ^(?:application|system|vendor|database|tests|docs|node_modules)(?:/|$) - [F,L,NC]
RewriteRule \.(?:sql|sqlite[0-9]?|zip|tar|gz|tgz|7z|rar|bak|old|orig|save|swp|swo|log|lock|env|ini|yml|yaml)(?:/|$) - [F,L,NC]
RewriteRule ~$ - [F,L]
RewriteRule ^(?:barcode\.php|create_audit_trail\.php|database_ta_unlock_requests\.sql|audit_trail\.sql)$ - [F,L,NC]

# No WordPress, database admin tools, or executable uploads belong to this app.
RewriteRule ^(?:wp-admin|wp-content|wp-includes|phpmyadmin|pma|cgi-bin)(?:/|$) - [F,L,NC]
RewriteRule ^(?:wp-login\.php|wp-config\.php|xmlrpc\.php|server-status|server-info)(?:/|$) - [F,L,NC]
RewriteRule ^(?:assets|uploads)/.*\.(?:php[0-9]*|phtml|phar|cgi|pl|py|sh|shtml)(?:[./]|$) - [F,L,NC]
# index.php remains the only public PHP entry point, including CI PATH_INFO URLs.
RewriteRule ^(?!index\.php(?:/|$))[^/]+\.(?:php[0-9]*|phtml|phar)(?:/|$) - [F,L,NC]

# These small public forms never upload files. Leave authenticated uploads alone.
<If "%{REQUEST_URI} =~ m#(?i)/(?:index\.php/)?(?:pages/)?(?:signup|signup_email_available|log_in|forgot_password|get_district_by_division)(?:/|$)#">
    LimitRequestBody 32768
</If>
ErrorDocument 413 "This form request is too large. Please reload the page and try again."

<IfModule mod_headers.c>
    Header unset X-Powered-By
    Header always unset X-Powered-By
    Header always set Allow "GET, HEAD, POST" env=APLEAD_METHOD_BLOCKED
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
    Header always set Cross-Origin-Opener-Policy "same-origin"
    Header always set Cross-Origin-Resource-Policy "same-origin"
    Header always set Content-Security-Policy "default-src 'self' https: data: blob:; script-src 'self' 'unsafe-inline' 'unsafe-eval' https:; style-src 'self' 'unsafe-inline' https:; img-src 'self' https: data: blob:; font-src 'self' https: data:; connect-src 'self' https:; frame-src https:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" "expr=%{HTTPS} == 'on'"
</IfModule>

<FilesMatch "(?i)(?:^(?:composer\.(?:json|lock)|readme|license\.txt)$|\.(?:md|rst)$)">
    Require all denied
</FilesMatch>

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php/$1 [L]
